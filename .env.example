# ==============================================================================
# Odoo <-> WooCommerce Integration Configuration
# ==============================================================================

# --- Odoo ERP Credentials ---
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_odoo_user@email.com
ODOO_PASSWORD=your_odoo_api_key_or_password

# --- Odoo Optional Settings ---
# Default shipping product SKU in Odoo (service product created if missing)
ODOO_SHIPPING_PRODUCT_CODE=DELIVERY
# Default discount product SKU in Odoo (service product created if missing)
ODOO_DISCOUNT_PRODUCT_CODE=DISCOUNT
# Fallback country ISO code if customer country is empty (e.g., US, LB, FR, AE)
ODOO_DEFAULT_COUNTRY_CODE=LB
# Optional warehouse/location IDs (leave empty to use default)
ODOO_WAREHOUSE_ID=
ODOO_LOCATION_ID=
# Optional shared token to authenticate webhooks sent from Odoo to FastAPI
ODOO_WEBHOOK_SECRET=your_odoo_webhook_token_here

# --- WooCommerce REST API ---
WC_URL=https://your-store.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WordPress Media Upload (for Product Images) ---
# Use WordPress Application Passwords (generated in WP Admin -> Users -> Profile)
WP_USERNAME=your_wp_admin_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- WooCommerce Webhook Verification ---
# Shared secret configured in WooCommerce -> Settings -> Advanced -> Webhooks
WC_WEBHOOK_SECRET=your_wc_webhook_secret_here

# --- Redis Store (Cooldown, Deduplication & SKU Caching) ---
REDIS_URL=redis://localhost:6379/0

# --- Sync Cadence & Limits ---
# Cooldown between duplicate webhooks (seconds)
COOLDOWN_SECONDS=15
WC_ORDER_COOLDOWN_SECONDS=30
# Periodic stock sync interval (seconds, default 900 = 15 minutes)
STOCK_SYNC_INTERVAL_SECONDS=900
# Periodic order reconciliation interval (seconds, default 3600 = 1 hour)
ORDER_RECONCILE_INTERVAL_SECONDS=3600
# Hours to look back for missed orders during reconciliation
ORDER_RECONCILE_HOURS=24
# Cache TTL for WooCommerce SKU mapping in Redis (seconds, default 3600 = 1 hour)
STOCK_CACHE_TTL=3600

# --- HTTP Timeouts (Seconds) ---
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
IMAGE_READ_TIMEOUT=60

# --- General ---
DEBUG=false
LOG_LEVEL=INFO
